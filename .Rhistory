)
data <- read_excel("data_merged_classified2.xlsx", sheet = 1)[,var_names]
data <- data %>%
mutate(
`Award Category` = case_when(
`Award Type` %in% c(
"R01", "R03", "R21", "R34", "R37", "R56", "RF1",
"DP2", "DP5"
) ~ "Research Projects",
`Award Type` %in% c(
"U01", "R61", "R33", "UG3", "R18"
) ~ "Cooperative / Multi-component Research",
`Award Type` %in% c(
"K01", "K08", "K23", "K24", "K99", "R00"
) ~ "Career Development & Transition",
`Award Type` %in% c(
"T32", "F30", "F32", "D43"
) ~ "Training & Fellowships",
`Award Type` %in% c(
"P20", "P30", "P50", "U48", "UM1", "RM1"
) ~ "Centers & Large Research Programs",
`Award Type` %in% c(
"R24"
) ~ "Research Infrastructure & Resource Development",
`Award Type` %in% c(
"R41", "R42", "R43", "R44"
) ~ "Small Business Research",
`Award Type` %in% c(
"R13", "R25"
) ~ "Conferences & Research Education",
TRUE ~ `Award Type`
),
`Award Types` = case_when(
`Award Category` == "Research Projects" ~
"R01, R03, R21, R34, R37, R56, RF1, DP2, DP5",
`Award Category` == "Cooperative / Multi-component Research" ~
"U01, R61, R33, UG3, R18",
`Award Category` == "Career Development & Transition" ~
"K01, K08, K23, K24, K99, R00",
`Award Category` == "Training & Fellowships" ~
"T32, F30, F32, D43",
`Award Category` == "Centers & Large Research Programs" ~
"P20, P30, P50, U48, UM1, RM1",
`Award Category` == "Research Infrastructure & Resource Development" ~
"R24",
`Award Category` == "Small Business Research" ~
"R41, R42, R43, R44",
`Award Category` == "Conferences & Research Education" ~
"R13, R25",
TRUE ~ `Award Type`
),
`mHealth` = case_when(
`mhealth_classification` == "mHealth-related" ~
"mHealth-related",
TRUE ~ "Not mHealth-related"
),
`Start Date` = as.Date(parse_date_time(
`Start Date`,
orders = c("mdy", "ymd HMS", "ymd")
)),
`End Date` = as.Date(parse_date_time(
`End Date`,
orders = c("mdy", "ymd HMS", "ymd")
))
)
